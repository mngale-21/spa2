# ============ DATABASE (SHARED NA MFUMO WA SALOON) ============
# HII NI DATABASE MOJA INAYOSHIRIKIWA na Salon Management System backend -
# thamani hii LAZIMA iwe SAWA KABISA na DATABASE_URL ya salon-system/backend/.env.
# Angalia README.md sehemu ya "Usanifu wa Database Moja" kwa maelezo zaidi.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salon_system?schema=public"

# ============ AUTH / SECURITY (ya Administration System pekee) ============
JWT_SECRET="badilisha_hii_na_neno_la_siri_refu_na_gumu_TOFAUTI_na_JWT_SECRET_ya_saloon"
JWT_EXPIRES_IN="7d"

# Akaunti ya Super Admin haitengenezwi hapa tena - inatengenezwa na
# `npm run seed` KWENYE salon-system/backend (angalia README.md).

# ============ EMAIL (SMTP) - INAFANYA KAZI MOJA KWA MOJA ============
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="yourcompany@gmail.com"
SMTP_PASS="app_password_yako"
SMTP_FROM_NAME="Salon SaaS Platform"
SMTP_FROM_EMAIL="yourcompany@gmail.com"

# ============ WHATSAPP (HIARI - angalia README.md) ============
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ============ MUUNGANIKO NA MFUMO WA SALOON (Salon Management System) =====
# Anwani MOJA TU ya deployment ya Salon Management System - kuna deployment
# MOJA inayotumiwa na makampuni YOTE (multi-tenant), si moja kwa kila mteja.
SALON_SYSTEM_URL="http://localhost:3000"

# LAZIMA iwe SAWA KABISA na TENANT_SSO_SECRET kwenye salon-system/backend/.env
# - hii ndiyo inayowezesha "Enter System" (support access) kufanya kazi.
TENANT_SSO_SECRET="siri_nyingine_ya_kuunganisha_na_mfumo_wa_saloon"
