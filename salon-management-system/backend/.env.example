# ============================================================================
# Backend Environment Variables
# Copy this file to `.env` and fill in real values before running the server.
# ============================================================================

# PostgreSQL connection string — this is the ONE shared database used by
# EVERY company on this platform (multi-tenant), and also by the separate
# Administration System app (it connects to this exact same database — see
# README.md section 11). Do not create a separate database per company.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salon_system?schema=public"

# Secret used to sign JWTs. Use a long, random value in production
# (e.g. `openssl rand -base64 48`).
JWT_SECRET="local-salon-jwt-secret-change-me"

# Port the Express API listens on.
PORT=5001

# Origin allowed by CORS — should match the Next.js frontend URL.
CLIENT_ORIGIN="http://localhost:3000"

NODE_ENV=development

# Web Push (real device notifications, even when logged out of the app).
# Generate a keypair with: npx web-push generate-vapid-keys
# Leave these blank to disable device push — everything else (in-app bell,
# real-time updates, audio alarm) still works without them.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Email (self-service "forgot password" for Cashier/Staff — see
# backend/src/utils/mailer.js). Leave SMTP_HOST blank in development and
# the reset link is logged to the server console instead of emailed, so
# the flow is still testable without real credentials. In production,
# fill these in or nobody can reset their own password — an Admin can
# still reset one directly from the Employees screen as a fallback.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Salon System <no-reply@yourdomain.com>"

# ============================================================================
# ADMINISTRATION SYSTEM INTEGRATION (the separate Super Admin panel that
# creates/suspends/manages every Company in THIS SAME shared database).
# See README.md -> "11. Administration System Integration" for the full
# architecture explanation.
# ============================================================================

# Both apps point at the SAME PostgreSQL database (see DATABASE_URL above) —
# this is deliberate: it's what lets the Administration System create a
# Company + its first Admin user directly, with no API round-trip needed.
# The ONE thing that still needs a signed token is "Enter System" (support
# access), because that has to move a browser from the Administration
# System's URL to THIS app's URL with a working session — that's what this
# secret protects. MUST be the EXACT same value in the Administration
# System's own .env.
TENANT_SSO_SECRET="local-platform-sso-secret-change-me"

# Used ONLY by prisma/seed.js to create the Administration System's first
# Super Admin login (stored in the `platform_admins` table of this same
# database). Change the password immediately after your first login.
DEFAULT_ADMIN_EMAIL="admin@localhost.test"
DEFAULT_ADMIN_PASSWORD="54321"
